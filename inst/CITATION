## Canonical citation(s) returned by `citation("gllvmTMB")`.
##
## - Primary entry: the gllvmTMB methods paper (Nakagawa et al., in prep).
##   Update the DOI / journal / volume / pages when the paper lands.
## - Recommended companion: cite TMB (Kristensen et al. 2016) for any
##   gllvmTMB fit.
##
## `meta` is bound by citation()/readCitationFile() to the package's
## DESCRIPTION metadata, so the version string below tracks
## DESCRIPTION's Version field automatically.

pkg_version <- if (!is.null(meta$Version)) meta$Version else "unknown"

bibentry(
  bibtype  = "Manual",
  key      = "gllvmTMB",
  title    = "gllvmTMB: Fit Multivariate Models from Wide Response
             Data",
  author   = c(
    person("Shinichi", "Nakagawa")
  ),
  year     = "2026",
  note     = paste0("R package version ", pkg_version, "; methods paper in preparation"),
  url      = "https://itchyshin.github.io/gllvmTMB/",
  textVersion = paste(
    "Nakagawa S (2026).",
    "gllvmTMB: Fit Multivariate Models from Wide Response Data.",
    paste0("R package version ", pkg_version, "; methods paper in preparation."),
    "https://itchyshin.github.io/gllvmTMB/"
  ),
  header   = paste(
    "To cite gllvmTMB itself:"
  )
)

